                            "    pm.expect(jsonData.status).to.eql('active');",
                            "    pm.expect(jsonData.origin).to.eql('DEL');",
                            "    pm.expect(jsonData.destination).to.eql('BOM');",
                            "    pm.collectionVariables.set('alert_id', jsonData.id.toString());",
                            "});"
