    "item": [
        {
            "name": "1. Register a new user",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Generate unique username to allow repeated test runs without conflicts",
                            "var uniqueSuffix = Date.now();",
                            "var username = 'traveler_' + uniqueSuffix;",
                            "pm.collectionVariables.set('current_username', username);",
                            "pm.collectionVariables.set('current_password', 'SecurePass123!');"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status code is 201 Created', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test('Response returns JWT access token and user info', function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('access');",
                            "    pm.expect(jsonData.access).to.be.a('string').that.is.not.empty;",
                            "    pm.expect(jsonData).to.have.property('username');",
                            "    pm.collectionVariables.set('regular_token', jsonData.access);",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"{{current_username}}\",\n    \"password\": \"{{current_password}}\",\n    \"email\": \"{{current_username}}@example.com\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/auth/register/",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "auth",
                        "register",
                        ""
                    ]
                }
            },
            "response": []
        },
