        {
            "name": "12. Admin summary - admin token",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "// Log in as admin and obtain admin JWT token",
                            "var baseUrl = pm.collectionVariables.get('base_url') || 'http://127.0.0.1:9000';",
                            "var adminUsername = pm.collectionVariables.get('admin_username') || 'admin';",
                            "var adminPassword = pm.collectionVariables.get('admin_password') || 'Admin1234!';",
                            "",
                            "pm.sendRequest({",
                            "    url: baseUrl + '/api/auth/login/',",
                            "    method: 'POST',",
                            "    header: { 'Content-Type': 'application/json' },",
                            "    body: {",
                            "        mode: 'raw',",
                            "        raw: JSON.stringify({",
                            "            username: adminUsername,",
                            "            password: adminPassword",
                            "        })",
                            "    }",
                            "}, function (err, res) {",
                            "    if (!err && res.code === 200) {",
                            "        var resData = res.json();",
                            "        pm.collectionVariables.set('admin_token', resData.access);",
                            "    }",
                            "});"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('Status code is 200 OK', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response returns dashboard aggregates and top routes', function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData).to.have.property('total_alerts');",
                            "    pm.expect(jsonData).to.have.property('active_alerts');",
                            "    pm.expect(jsonData).to.have.property('triggered_alerts');",
                            "    pm.expect(jsonData).to.have.property('total_notifications');",
                            "    pm.expect(jsonData).to.have.property('top_routes');",
                            "    pm.expect(jsonData.top_routes).to.be.an('array');",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
